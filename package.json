{
  "name": "vero-relayer-service",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "worker:events": "node src/workers/event-worker.js",
    "simulate": "node scripts/mock-webhook.js",
    "db:migrate": "node -e \"require('./src/db/run-migrations').runMigrations().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "test": "node --test --require ./test/global-teardown.js",
    "benchmark:pool": "node benchmarks/pool-performance.js",
    "validate:pool": "node scripts/validate-pool-setup.js"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@stellar/stellar-sdk": "16.2.0",
    "bullmq": "^6.1.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "prom-client": "^15.0.0",
    "supertest": "7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "gaxios": "^7.3.0"
  }
}
