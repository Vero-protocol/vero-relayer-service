# Configuration Blueprint
STELLAR_SECRET_KEY=
STELLAR_NETWORK=testnet

# Stellar Horizon URLs (comma-separated for failover)
STELLAR_HORIZON_URLS=
STELLAR_RPC_URLS=

# PostgreSQL Database Configuration
# Use either DATABASE_URL or individual parameters (DATABASE_URL takes precedence)
DATABASE_URL=postgresql://user:password@localhost:5432/vero_relayer
PGHOST=localhost
PGPORT=5432
PGUSER=vero_relayer
PGPASSWORD=change-me
PGDATABASE=vero_relayer
# Connection pool settings for handling concurrent requests efficiently
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# Service-to-service JWT auth
# Must be at least 32 characters. Rotate periodically.
JWT_SIGNING_SECRET=change-me-to-a-strong-random-secret-min-32-chars
JWT_ISSUER=vero-relayer-service

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=change-me
REDIS_TLS=false
EVENT_QUEUE_NAME=vero:event-processing
EVENT_QUEUE_CONCURRENCY=5
EVENT_QUEUE_RETRY_ATTEMPTS=5
EVENT_QUEUE_RETRY_BACKOFF_DELAY=5000
# Persisted retry backoff schedule in milliseconds (comma-separated)
RETRY_BACKOFFS_MS=5000,15000,45000,120000,300000
EVENT_PAYLOAD_RETENTION_DAYS=7

# Rate limiting configuration (IP-based)
# Window in milliseconds for rate limiting (default 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window for unauthenticated/public clients
RATE_LIMIT_PUBLIC_MAX=100
# Maximum requests per window for authenticated clients (JWT/HMAC)
RATE_LIMIT_AUTH_MAX=1000

# /metrics endpoint protection (JWT Bearer auth is required by default)
# Lightweight per-client scrape limiter defaults to 60 requests per 60 seconds.
METRICS_RATE_LIMIT_WINDOW_MS=60000
METRICS_RATE_LIMIT_MAX=60

# OpenTelemetry / tracing
OTEL_SERVICE_NAME=vero-relayer-service
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SDK_DISABLED=false

# Dynamic config sync from KV store
# Interval in milliseconds for polling config changes from Redis
CONFIG_SYNC_INTERVAL_MS=5000
# Enable async worker for performance-optimized config polling
CONFIG_ASYNC_WORKER=false
